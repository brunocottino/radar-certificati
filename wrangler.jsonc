// Configurazione del Worker che serve il sito (Cloudflare Workers Builds la legge a ogni push).
// Il sito è statico: la cartella docs/ (pagina, dati, API). I domini personalizzati sono dichiarati qui,
// così anche www.radarcertificati.com punta al sito senza passare dal pannello.
// worker/index.js costruisce le schede /certificato/<ISIN>, rimanda www al dominio principale e serve le pagine di docs/.
{
  "name": "radar-certificati",
  "compatibility_date": "2026-10-01",
  "main": "worker/index.js",
  // il worker passa per primo sulle pagine (per rimandare www al dominio principale); dati, API e caratteri restano file diretti
  "assets": { "directory": "./docs", "binding": "ASSETS", "run_worker_first": ["/*", "!/api/*", "!/data/*", "!/fonts/*"] },
  "workers_dev": true,
  // non cancellare a ogni push le variabili messe a mano nel pannello Cloudflare (es. GH_TOKEN come testo)
  "keep_vars": true,
  // orologio del robot (UTC; il codice tiene solo le occorrenze giuste per l'ora di Roma): vedi worker/index.js
  "triggers": { "crons": ["35,50 7-10 * * 1-5", "15,45 14-17 * * 1-5"] },
  "routes": [
    { "pattern": "radarcertificati.com", "custom_domain": true },
    { "pattern": "www.radarcertificati.com", "custom_domain": true }
  ]
}
